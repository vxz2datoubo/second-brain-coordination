{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "IntegrationStateIsolationReceipt/v1",
  "title": "Integration State Isolation Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "repository",
    "initial_main_sha",
    "final_main_sha",
    "initial_candidate_sha",
    "final_candidate_sha",
    "merge_base_sha",
    "integration_commit_sha",
    "integration_parent_shas",
    "main_tree_sha",
    "integrated_tree_sha",
    "python_version",
    "baseline_test_count",
    "integrated_test_count",
    "baseline_test_id_digest",
    "integrated_test_id_digest",
    "baseline_state_digest",
    "integrated_state_digest",
    "candidate_only_test_ids",
    "missing_baseline_test_ids",
    "baseline_failures_preserved",
    "baseline_improvements",
    "candidate_introduced_failures",
    "candidate_modified_baseline_failures",
    "candidate_exact_head_failures",
    "baseline_command_count",
    "integrated_command_count",
    "baseline_command_id_digest",
    "integrated_command_id_digest",
    "baseline_command_state_digest",
    "integrated_command_state_digest",
    "baseline_command_failures_preserved",
    "command_improvements",
    "candidate_introduced_command_failures",
    "candidate_modified_baseline_command_failures",
    "per_command_observations",
    "environment_errors",
    "per_test_observations",
    "classification",
    "baseline_declared_healthy",
    "authority",
    "receipt_digest"
  ],
  "properties": {
    "schema": {
      "const": "IntegrationStateIsolationReceipt/v1"
    },
    "repository": {
      "type": [
        "string",
        "null"
      ]
    },
    "initial_main_sha": {
      "$ref": "#/$defs/shaOrNull"
    },
    "final_main_sha": {
      "$ref": "#/$defs/shaOrNull"
    },
    "initial_candidate_sha": {
      "$ref": "#/$defs/shaOrNull"
    },
    "final_candidate_sha": {
      "$ref": "#/$defs/shaOrNull"
    },
    "merge_base_sha": {
      "$ref": "#/$defs/shaOrNull"
    },
    "integration_commit_sha": {
      "$ref": "#/$defs/shaOrNull"
    },
    "integration_parent_shas": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{40}$"
      },
      "maxItems": 2
    },
    "main_tree_sha": {
      "$ref": "#/$defs/shaOrNull"
    },
    "integrated_tree_sha": {
      "$ref": "#/$defs/shaOrNull"
    },
    "python_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "baseline_test_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "integrated_test_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "baseline_test_id_digest": {
      "$ref": "#/$defs/digestOrNull"
    },
    "integrated_test_id_digest": {
      "$ref": "#/$defs/digestOrNull"
    },
    "baseline_state_digest": {
      "$ref": "#/$defs/digestOrNull"
    },
    "integrated_state_digest": {
      "$ref": "#/$defs/digestOrNull"
    },
    "candidate_only_test_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "missing_baseline_test_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "baseline_failures_preserved": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "baseline_improvements": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "candidate_introduced_failures": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "candidate_modified_baseline_failures": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "candidate_exact_head_failures": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "baseline_command_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "integrated_command_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "baseline_command_id_digest": {
      "$ref": "#/$defs/digestOrNull"
    },
    "integrated_command_id_digest": {
      "$ref": "#/$defs/digestOrNull"
    },
    "baseline_command_state_digest": {
      "$ref": "#/$defs/digestOrNull"
    },
    "integrated_command_state_digest": {
      "$ref": "#/$defs/digestOrNull"
    },
    "baseline_command_failures_preserved": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "command_improvements": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "candidate_introduced_command_failures": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "candidate_modified_baseline_command_failures": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "per_command_observations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "environment_errors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "per_test_observations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "classification": {
      "enum": [
        "PASS_NO_CANDIDATE_REGRESSION",
        "TEST_ENVIRONMENT_INVALID",
        "CANDIDATE_EXACT_HEAD_FAILURE",
        "CANDIDATE_INTRODUCED_FAILURE",
        "CANDIDATE_MODIFIED_BASELINE_FAILURE"
      ]
    },
    "baseline_declared_healthy": {
      "const": false
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_authorized",
        "ready_transition_authorized",
        "merge_authorized",
        "release_authorized",
        "domain_write_authorized",
        "trading_authorized"
      ],
      "properties": {
        "review_authorized": {
          "const": false
        },
        "ready_transition_authorized": {
          "const": false
        },
        "merge_authorized": {
          "const": false
        },
        "release_authorized": {
          "const": false
        },
        "domain_write_authorized": {
          "const": false
        },
        "trading_authorized": {
          "const": false
        }
      }
    },
    "receipt_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "shaOrNull": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "digestOrNull": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
