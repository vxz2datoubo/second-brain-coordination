{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://second-brain.local/contracts/ds02/belief-packet-v1.schema.json",
  "title": "BeliefPacket/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "identity", "temporal_provenance", "prior", "evidence", "update", "validation", "predictive", "diagnostics", "numeric_integrity", "authority"],
  "properties": {
    "schema": {"const": "BeliefPacket/v1"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["belief_id", "target_id", "target_definition_version", "scope_type", "symbol_or_universe", "exchange", "board", "security_type", "forecast_horizon", "as_of_time", "knowledge_cutoff", "market_rule_version", "market_rule_clause_state_version", "rule_clause_ids"],
      "properties": {
        "belief_id": {"type": "string", "minLength": 1},
        "target_id": {"type": "string", "minLength": 1},
        "target_definition_version": {"type": "string", "minLength": 1},
        "scope_type": {"const": "SINGLE_SECURITY"},
        "symbol_or_universe": {"type": "string", "pattern": "^[0-9]{6}$"},
        "exchange": {"enum": ["SSE", "SZSE", "BSE"]},
        "board": {"enum": ["MAIN", "STAR", "CHINEXT", "BSE"]},
        "security_type": {"const": "A_SHARE_STOCK"},
        "forecast_horizon": {"enum": ["INTRADAY", "1D", "3D", "5D", "10D", "20D", "60D"]},
        "as_of_time": {"type": "string", "format": "date-time"},
        "knowledge_cutoff": {"type": "string", "format": "date-time"},
        "market_rule_version": {"enum": ["SSE_TRADING_RULES_2026", "SZSE_TRADING_RULES_2026", "BSE_TRADING_RULES_2026"]},
        "market_rule_clause_state_version": {"enum": ["SSE_RULE_STATE_2026-07-06_ACTIVE", "SZSE_RULE_STATE_2026-07-06_ACTIVE", "BSE_RULE_STATE_2026-07-06_PARTIAL_DEFERRED"]},
        "rule_clause_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "allOf": [
        {"if": {"properties": {"exchange": {"const": "SSE"}}, "required": ["exchange"]}, "then": {"properties": {"board": {"enum": ["MAIN", "STAR"]}, "market_rule_version": {"const": "SSE_TRADING_RULES_2026"}, "market_rule_clause_state_version": {"const": "SSE_RULE_STATE_2026-07-06_ACTIVE"}}}},
        {"if": {"properties": {"exchange": {"const": "SZSE"}}, "required": ["exchange"]}, "then": {"properties": {"board": {"enum": ["MAIN", "CHINEXT"]}, "market_rule_version": {"const": "SZSE_TRADING_RULES_2026"}, "market_rule_clause_state_version": {"const": "SZSE_RULE_STATE_2026-07-06_ACTIVE"}}}},
        {"if": {"properties": {"exchange": {"const": "BSE"}}, "required": ["exchange"]}, "then": {"properties": {"board": {"const": "BSE"}, "market_rule_version": {"const": "BSE_TRADING_RULES_2026"}, "market_rule_clause_state_version": {"const": "BSE_RULE_STATE_2026-07-06_PARTIAL_DEFERRED"}}}}
      ]
    },
    "temporal_provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["decision_time"],
      "properties": {"decision_time": {"type": "string", "format": "date-time"}}
    },
    "prior": {
      "type": "object", "additionalProperties": false,
      "required": ["prior_id", "prior_version", "family", "parameters", "training_window", "effective_from", "evidence_digest"],
      "properties": {
        "prior_id": {"type": "string", "minLength": 1},
        "prior_version": {"type": "string", "minLength": 1},
        "family": {"type": "string", "minLength": 1},
        "parameters": {"type": "object"},
        "training_window": {"type": "string", "minLength": 1},
        "effective_from": {"type": "string", "format": "date-time"},
        "evidence_digest": {"type": "string", "minLength": 8}
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["evidence_id", "source_ref", "dependence_provenance", "revision_provenance", "available_at", "data_snapshot_hash", "feature_definition_version", "polarity", "likelihood_model_id", "likelihood_model_version", "status"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "source_ref": {"type": "string", "minLength": 1},
          "dependence_provenance": {
            "type": "object", "additionalProperties": false,
            "required": ["source_instance_id", "source_family_id", "candidate_independence_group_id", "ancestry_refs", "shared_feed_group_ids", "shared_feature_group_ids", "shared_training_data_group_ids", "shared_model_lineage_ids", "dependence_authority_state", "independence_status"],
            "properties": {
              "source_instance_id": {"type": "string", "minLength": 1},
              "source_family_id": {"type": "string", "minLength": 1},
              "candidate_independence_group_id": {"type": ["string", "null"], "minLength": 1},
              "ancestry_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
              "shared_feed_group_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
              "shared_feature_group_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
              "shared_training_data_group_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
              "shared_model_lineage_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
              "dependence_authority_state": {"const": "UNAVAILABLE_PHASE1"},
              "independence_status": {"const": "UNVERIFIED"}
            }
          },
          "revision_provenance": {
            "type": "object", "additionalProperties": false,
            "required": ["revision_id", "is_revised", "supersedes_snapshot_hashes"],
            "properties": {
              "revision_id": {"type": "string", "minLength": 1},
              "is_revised": {"type": "boolean"},
              "supersedes_snapshot_hashes": {"type": "array", "items": {"type": "string", "minLength": 8}, "uniqueItems": true}
            },
            "allOf": [
              {"if": {"properties": {"is_revised": {"const": true}}, "required": ["is_revised"]}, "then": {"properties": {"supersedes_snapshot_hashes": {"minItems": 1}}}}
            ]
          },
          "available_at": {"type": "string", "format": "date-time"},
          "data_snapshot_hash": {"type": "string", "minLength": 8},
          "feature_definition_version": {"type": "string", "minLength": 1},
          "polarity": {"enum": ["POSITIVE", "NEGATIVE", "NEUTRAL", "NON_DIRECTIONAL"]},
          "likelihood_model_id": {"type": "string", "minLength": 1},
          "likelihood_model_version": {"type": "string", "minLength": 1},
          "status": {"enum": ["ADMITTED", "INVALIDATED", "RETRACTED", "UNKNOWN"]}
        }
      }
    },
    "update": {
      "type": "object", "additionalProperties": false,
      "required": ["prior_probability", "cumulative_log_bayes_factor", "posterior_probability", "unknown_mass", "belief_state"],
      "properties": {
        "prior_probability": {"type": "number", "minimum": 0, "maximum": 1},
        "cumulative_log_bayes_factor": {"type": "number"},
        "posterior_probability": {"type": "number", "minimum": 0, "maximum": 1},
        "unknown_mass": {"type": "number", "minimum": 0, "maximum": 1},
        "belief_state": {"enum": ["PROPOSAL", "UNKNOWN", "ABSTAIN", "REVALIDATION_REQUIRED"]}
      }
    },
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": ["authority_state", "packet_status", "validated_computation_receipt", "canonical_belief_authorized"],
      "properties": {
        "authority_state": {"const": "UNAVAILABLE_PHASE1"},
        "packet_status": {"const": "UNVALIDATED_PROPOSAL"},
        "validated_computation_receipt": {"type": "null"},
        "canonical_belief_authorized": {"const": false}
      }
    },
    "predictive": {
      "type": "object", "additionalProperties": false,
      "required": ["expected_value", "quantiles", "probability_positive", "probability_below_loss_threshold", "predictive_distribution_ref"],
      "properties": {
        "expected_value": {"type": ["number", "null"]},
        "quantiles": {
          "type": "object", "additionalProperties": false,
          "required": ["p05", "p25", "p50", "p75", "p95"],
          "properties": {
            "p05": {"type": ["number", "null"]}, "p25": {"type": ["number", "null"]},
            "p50": {"type": ["number", "null"]}, "p75": {"type": ["number", "null"]},
            "p95": {"type": ["number", "null"]}
          }
        },
        "probability_positive": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "probability_below_loss_threshold": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "predictive_distribution_ref": {"type": "string", "minLength": 1}
      }
    },
    "diagnostics": {
      "type": "object", "additionalProperties": false,
      "required": ["engine", "engine_version", "code_sha", "calibration_status", "prior_predictive_status", "posterior_predictive_status"],
      "properties": {
        "engine": {"type": "string", "minLength": 1}, "engine_version": {"type": "string", "minLength": 1},
        "code_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "seed": {"type": ["integer", "null"]},
        "rhat_max": {"type": ["number", "null"], "minimum": 1},
        "ess_bulk_min": {"type": ["number", "null"], "minimum": 0},
        "ess_tail_min": {"type": ["number", "null"], "minimum": 0},
        "divergences": {"type": ["integer", "null"], "minimum": 0},
        "pareto_k_max": {"type": ["number", "null"]},
        "calibration_status": {"enum": ["NOT_RUN", "PASS", "FAIL", "REVALIDATION_REQUIRED"]},
        "prior_predictive_status": {"enum": ["NOT_RUN", "PASS", "FAIL"]},
        "posterior_predictive_status": {"enum": ["NOT_RUN", "PASS", "FAIL"]}
      }
    },
    "numeric_integrity": {
      "type": "object", "additionalProperties": false,
      "required": ["probability_serialization_decimals", "rounding_mode", "ui_precision_is_authority", "canonical_digest"],
      "properties": {
        "probability_serialization_decimals": {"const": 12},
        "rounding_mode": {"const": "ROUND_HALF_EVEN"},
        "ui_precision_is_authority": {"const": false},
        "canonical_digest": {"type": "string", "minLength": 8}
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["market_truth_authority", "event_truth_authority", "regime_authority", "epistemic_authority", "decision_authority", "risk_override_authority", "position_authority", "order_authority", "trade_authority"],
      "properties": {
        "market_truth_authority": {"const": false}, "event_truth_authority": {"const": false},
        "regime_authority": {"const": false}, "epistemic_authority": {"const": false},
        "decision_authority": {"const": false}, "risk_override_authority": {"const": false},
        "position_authority": {"const": false}, "order_authority": {"const": false}, "trade_authority": {"const": false}
      }
    }
  }
}
