{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/a-share-market-participant-map.schema.json",
  "title": "Candidate A-share Market Participant Map",
  "type": "object",
  "additionalProperties": false,
  "required": ["map_id", "as_of", "identity_status", "hypotheses", "source_refs", "boundary"],
  "properties": {
    "map_id": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date-time"},
    "identity_status": {"const": "latent_hypotheses_only"},
    "boundary": {"const": "research_only_no_trade"},
    "source_refs": {"type": "array", "items": {"type": "string"}},
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hypothesis_id", "family_id", "subtype_id", "posterior_probability", "evidence_refs", "counterevidence_refs", "alternative_hypothesis_ids", "invalidation_conditions"],
        "properties": {
          "hypothesis_id": {"type": "string"},
          "family_id": {"enum": ["quant_strategy", "active_speculative_capital", "large_capital_and_inventory", "retail_population", "unknown_actor_cluster"]},
          "subtype_id": {"type": "string"},
          "posterior_probability": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "counterevidence_refs": {"type": "array", "items": {"type": "string"}},
          "alternative_hypothesis_ids": {"type": "array", "items": {"type": "string"}},
          "invalidation_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "forbidden_downstream_use": {"const": "no_identity_assertion_or_trade_instruction"}
        }
      }
    }
  }
}
