{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://second-brain.local/schemas/LockboxAccessReceipt-v1.json",
  "title": "LockboxAccessReceipt/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "access_id", "lockbox_id", "opened_at", "candidate_id", "candidate_digest", "purpose",
    "result_digest", "selection_consumed_after", "task_id", "accessor_id", "code_digest", "parameter_digest",
    "cost_model_digest", "rule_snapshot_digest", "dataset_snapshot_digest", "frozen_configuration_digest",
    "subsequent_action"
  ],
  "properties": {
    "schema": {"const": "LockboxAccessReceipt/v1"},
    "access_id": {"type": "string", "minLength": 1},
    "lockbox_id": {"type": "string", "minLength": 1},
    "opened_at": {"type": "string", "format": "date-time"},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "purpose": {"enum": ["FINAL_EVAL", "TUNING", "FEATURE_ENGINEERING", "PROMPT_OPTIMIZATION", "MODEL_SELECTION", "PARAMETER_SELECTION", "RESELECTION", "DIAGNOSTIC"]},
    "result_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selection_consumed_after": {"type": "boolean"},
    "task_id": {"type": "string", "minLength": 1},
    "accessor_id": {"type": "string", "minLength": 1},
    "code_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "parameter_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cost_model_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rule_snapshot_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dataset_snapshot_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "frozen_configuration_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "subsequent_action": {"type": ["string", "null"], "minLength": 1}
  }
}
