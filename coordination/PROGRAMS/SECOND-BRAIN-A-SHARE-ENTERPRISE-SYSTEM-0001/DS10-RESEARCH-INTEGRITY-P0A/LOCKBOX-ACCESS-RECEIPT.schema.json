{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://second-brain.local/schemas/LockboxAccessReceipt-v1.json",
  "title": "LockboxAccessReceipt/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "access_id", "lockbox_id", "opened_at", "candidate_id", "candidate_digest", "purpose",
    "result_digest", "selection_consumed_after",
    "dataset_artifact_ref", "dataset_artifact_blob_sha",
    "code_artifact_ref", "code_artifact_blob_sha",
    "parameter_artifact_ref", "parameter_artifact_blob_sha",
    "cost_artifact_ref", "cost_artifact_blob_sha",
    "rule_artifact_ref", "rule_artifact_blob_sha", "rule_snapshot_id",
    "accessor_claim_ref", "accessor_claim_blob_sha",
    "authorization_witness_ref", "authorization_witness_blob_sha",
    "accessor_id", "task_id", "configuration_frozen_at", "configuration_digest",
    "subsequent_action"
  ],
  "properties": {
    "schema": {"const": "LockboxAccessReceipt/v1"},
    "access_id": {"type": "string", "minLength": 1},
    "lockbox_id": {"type": "string", "minLength": 1},
    "opened_at": {"type": "string", "format": "date-time"},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate_digest": {"$ref": "#/$defs/sha256"},
    "purpose": {"enum": ["FINAL_EVAL", "TUNING", "FEATURE_ENGINEERING", "PROMPT_OPTIMIZATION", "MODEL_SELECTION", "PARAMETER_SELECTION", "RESELECTION", "DIAGNOSTIC"]},
    "result_digest": {"$ref": "#/$defs/sha256"},
    "selection_consumed_after": {"type": "boolean"},
    "dataset_artifact_ref": {"type": ["string", "null"], "minLength": 1},
    "dataset_artifact_blob_sha": {"$ref": "#/$defs/gitBlobOrNull"},
    "code_artifact_ref": {"type": ["string", "null"], "minLength": 1},
    "code_artifact_blob_sha": {"$ref": "#/$defs/gitBlobOrNull"},
    "parameter_artifact_ref": {"type": ["string", "null"], "minLength": 1},
    "parameter_artifact_blob_sha": {"$ref": "#/$defs/gitBlobOrNull"},
    "cost_artifact_ref": {"type": ["string", "null"], "minLength": 1},
    "cost_artifact_blob_sha": {"$ref": "#/$defs/gitBlobOrNull"},
    "rule_artifact_ref": {"type": ["string", "null"], "minLength": 1},
    "rule_artifact_blob_sha": {"$ref": "#/$defs/gitBlobOrNull"},
    "rule_snapshot_id": {"type": ["string", "null"], "minLength": 1},
    "accessor_claim_ref": {"type": ["string", "null"], "minLength": 1},
    "accessor_claim_blob_sha": {"$ref": "#/$defs/gitBlobOrNull"},
    "authorization_witness_ref": {"type": ["string", "null"], "minLength": 1},
    "authorization_witness_blob_sha": {"$ref": "#/$defs/gitBlobOrNull"},
    "accessor_id": {"type": ["string", "null"], "minLength": 1},
    "task_id": {"type": ["string", "null"], "minLength": 1},
    "configuration_frozen_at": {"type": ["string", "null"], "format": "date-time"},
    "configuration_digest": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "subsequent_action": {"type": ["string", "null"], "minLength": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitBlobOrNull": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}
  }
}
