{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "MarketSemanticFieldSpec/v1",
  "title": "MarketSemanticFieldSpec/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["semantic_field_id", "semantic_version", "source_system", "source_version", "source_field_name", "canonical_field_ref", "primitive_type", "unit_kind", "unit_symbol", "unit_scale", "rounding_policy", "adjustment_state", "source_enum_map", "allowed_missing_states", "canonical_persistable", "evidence_ref"],
  "properties": {
    "semantic_field_id": {"type": "string", "minLength": 1},
    "semantic_version": {"type": "string", "minLength": 1},
    "source_system": {"type": "string", "minLength": 1},
    "source_version": {"type": "string", "minLength": 1},
    "source_field_name": {"type": "string", "minLength": 1},
    "canonical_field_ref": {"type": "string", "minLength": 1},
    "primitive_type": {"enum": ["DECIMAL_STRING", "INTEGER", "ENUM_STRING", "ISO8601", "STRING"]},
    "unit_kind": {"type": "string", "minLength": 1},
    "unit_symbol": {"type": "string", "minLength": 1},
    "unit_scale": {"type": "string", "pattern": "^[+]?(?:\\d+)(?:\\.\\d+)?$"},
    "fixed_scale": {"type": ["string", "null"], "pattern": "^[+]?(?:\\d+)(?:\\.\\d+)?$"},
    "tick_size": {"type": ["string", "null"], "pattern": "^[+]?(?:\\d+)(?:\\.\\d+)?$"},
    "tick_size_ref": {"type": ["string", "null"]},
    "rounding_policy": {"type": "string", "minLength": 1},
    "price_semantic": {"type": ["string", "null"], "enum": [null, "RAW_TRADE_PRICE", "QUOTE_PRICE", "REFERENCE_PRICE", "ADJUSTED_PRICE", "DISPLAY_PRICE"]},
    "time_semantic": {"type": ["string", "null"], "enum": [null, "EVENT_TIME", "EXCHANGE_TIME", "PUBLISHED_AT", "AVAILABLE_AT", "INGESTED_AT"]},
    "adjustment_state": {"type": "string", "minLength": 1},
    "source_enum_map": {"type": "object", "additionalProperties": {"enum": ["BUY", "SELL", "UNKNOWN"]}},
    "allowed_missing_states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["PRESENT", "NOT_AVAILABLE", "NOT_APPLICABLE", "SOURCE_MISSING", "PERMISSION_OR_ENTITLEMENT_UNVERIFIED", "MARKET_NOT_OPEN", "STALE", "UNVERIFIED", "UNKNOWN"]}},
    "canonical_persistable": {"type": "boolean"},
    "valid_from": {"type": ["string", "null"], "format": "date-time"},
    "valid_until": {"type": ["string", "null"], "format": "date-time"},
    "evidence_ref": {"type": "string"},
    "last_verified_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"price_semantic": {"const": "DISPLAY_PRICE"}}, "required": ["price_semantic"]},
      "then": {"properties": {"canonical_persistable": {"const": false}}}
    }
  ]
}
