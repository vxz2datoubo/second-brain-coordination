{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qclaw:e34:KnowledgeAtom:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "atom_id", "schema_version", "content", "content_type",
    "source_span", "source_blob_sha", "source_commit_sha"
  ],
  "properties": {
    "atom_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 deterministic atom ID"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1.[0-9]+.[0-9]+$",
      "description": "Schema semantic version"
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "description": "Semantic content (zh or en)"
    },
    "content_type": {
      "type": "string",
      "enum": [
        "CLAIM", "FACT", "CONDITION", "EXCEPTION", "NEGATION",
        "COUNTEREXAMPLE", "UNKNOWN", "CONFLICT", "TEMPORAL_SCOPE",
        "CONSTRAINT", "METHOD", "DEFINITION", "REFERENCE",
        "SOURCE", "EXAMPLE", "CODE_BLOCK", "STRUCTURAL",
        "GOVERNANCE", "AUTHORITY", "CONTEXT", "METADATA"
      ]
    },
    "source_span": {
      "type": "object",
      "required": ["start_byte", "end_byte"],
      "properties": {
        "start_byte": {"type": "integer", "minimum": 0},
        "end_byte": {"type": "integer", "minimum": 0}
      }
    },
    "source_blob_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "confidence": {
      "type": "string",
      "enum": ["candidate", "verified", "disputed"],
      "default": "candidate"
    },
    "authority": {
      "type": "string",
      "enum": ["candidate", "acknowledged", "canonical"],
      "default": "candidate"
    },
    "conditions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "exceptions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "negations": {
      "type": "array",
      "items": {"type": "string"}
    },
    "temporal_scope": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "default": "1.0"
    },
    "related_atom_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    }
  }
}
