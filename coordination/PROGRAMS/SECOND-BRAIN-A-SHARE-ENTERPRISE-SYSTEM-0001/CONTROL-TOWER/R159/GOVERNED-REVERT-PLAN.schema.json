{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.second-brain.local/control-tower/r159/governed-revert-plan/1.0.0",
  "title": "GovernedRevertPlan/v1",
  "type": "object",
  "required": [
    "schema_version",
    "checkpoint_id",
    "checkpoint_digest",
    "target_commit",
    "target_tree",
    "change_id",
    "assessment_digest",
    "reversibility_class",
    "strategy",
    "reason",
    "preserve_history",
    "destructive_history_rewrite",
    "exact_head_reverification_required",
    "independent_review_required",
    "user_approval_required",
    "authority",
    "plan_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "GovernedRevertPlan/v1"
    },
    "checkpoint_id": {
      "type": "string",
      "pattern": "^KGC-[0-9a-f]{16}$"
    },
    "checkpoint_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "target_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "change_id": {
      "type": "string",
      "minLength": 1
    },
    "assessment_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reversibility_class": {
      "enum": [
        "COMPENSATABLE_ONLY",
        "REVERSIBLE_BY_VERSION_SWITCH",
        "REVERSIBLE_GIT_ONLY",
        "REVERSIBLE_WITH_MIGRATION",
        "REVERSIBLE_WITH_SNAPSHOT"
      ]
    },
    "strategy": {
      "enum": [
        "COMPENSATING_ACTION_PLUS_FORWARD_REVERT",
        "FORWARD_REVERT_PLUS_DOWN_MIGRATION",
        "FORWARD_REVERT_PLUS_SNAPSHOT_RESTORE",
        "FORWARD_REVERT_PR_OR_CORRECTIVE_COMMIT",
        "VERSION_SWITCH_OR_FEATURE_FLAG"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "preserve_history": {
      "const": true
    },
    "destructive_history_rewrite": {
      "const": false
    },
    "exact_head_reverification_required": {
      "const": true
    },
    "independent_review_required": {
      "type": "boolean"
    },
    "user_approval_required": {
      "type": "boolean"
    },
    "authority": {
      "type": "object",
      "required": [
        "creates_task",
        "creates_route",
        "creates_work_claim",
        "grants_execution",
        "grants_write",
        "grants_review_accept",
        "grants_merge",
        "grants_release",
        "grants_trading"
      ],
      "properties": {
        "creates_task": {
          "const": false
        },
        "creates_route": {
          "const": false
        },
        "creates_work_claim": {
          "const": false
        },
        "grants_execution": {
          "const": false
        },
        "grants_write": {
          "const": false
        },
        "grants_review_accept": {
          "const": false
        },
        "grants_merge": {
          "const": false
        },
        "grants_release": {
          "const": false
        },
        "grants_trading": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
