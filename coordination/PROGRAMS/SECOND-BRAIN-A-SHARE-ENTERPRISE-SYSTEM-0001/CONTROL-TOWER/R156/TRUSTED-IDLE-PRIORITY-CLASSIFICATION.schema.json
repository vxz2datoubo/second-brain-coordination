{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:second-brain:r156:trusted-idle-priority-classification:v1",
  "title": "TrustedIdlePriorityClassificationEvidence/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_version",
    "signal_ref",
    "base_opportunity_digest",
    "epistemic_state",
    "priority_class",
    "reason",
    "source_evidence_refs",
    "authority_boundary",
    "evidence_digest"
  ],
  "properties": {
    "schema_version": {"const": "TrustedIdlePriorityClassificationEvidence/v1"},
    "policy_version": {"const": "R156/v1"},
    "signal_ref": {"type": "string", "minLength": 1},
    "base_opportunity_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "epistemic_state": {
      "enum": [
        "USER_EXPLICIT",
        "CONFIRMED_FACT",
        "HIGH_CONFIDENCE_INFERENCE",
        "CANDIDATE_HYPOTHESIS"
      ]
    },
    "priority_class": {
      "enum": ["P3_BOUNDED_IMPROVEMENT", "P4_RESEARCH"]
    },
    "reason": {
      "enum": [
        "CANONICAL_ACTION_CAPABLE_EPISTEMIC_STATE_PRESERVES_P3",
        "CANONICAL_CANDIDATE_HYPOTHESIS_REQUIRES_RESEARCH"
      ]
    },
    "source_evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selects_opportunity",
        "releases_task",
        "creates_task",
        "creates_issue",
        "creates_route",
        "creates_work_claim",
        "creates_worker_slot",
        "grants_execution_authority",
        "grants_domain_write",
        "grants_w3_write",
        "grants_merge_authority"
      ],
      "properties": {
        "selects_opportunity": {"const": false},
        "releases_task": {"const": false},
        "creates_task": {"const": false},
        "creates_issue": {"const": false},
        "creates_route": {"const": false},
        "creates_work_claim": {"const": false},
        "creates_worker_slot": {"const": false},
        "grants_execution_authority": {"const": false},
        "grants_domain_write": {"const": false},
        "grants_w3_write": {"const": false},
        "grants_merge_authority": {"const": false}
      }
    },
    "evidence_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"epistemic_state": {"const": "CANDIDATE_HYPOTHESIS"}}},
      "then": {
        "properties": {
          "priority_class": {"const": "P4_RESEARCH"},
          "reason": {"const": "CANONICAL_CANDIDATE_HYPOTHESIS_REQUIRES_RESEARCH"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "epistemic_state": {
            "enum": ["USER_EXPLICIT", "CONFIRMED_FACT", "HIGH_CONFIDENCE_INFERENCE"]
          }
        }
      },
      "then": {
        "properties": {
          "priority_class": {"const": "P3_BOUNDED_IMPROVEMENT"},
          "reason": {"const": "CANONICAL_ACTION_CAPABLE_EPISTEMIC_STATE_PRESERVES_P3"}
        }
      }
    }
  ]
}
