{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://second-brain.local/schemas/EventCoverageReport-v1.json",
  "title": "EventCoverageReport/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intent_class",
    "target_symbols",
    "proxy_symbols",
    "window_start",
    "anomaly_or_query_at",
    "source_authority_state",
    "required_coverage_roles",
    "observed_coverage_roles",
    "scanned_source_ids",
    "scanned_proxy_symbols",
    "unresolved_source_gaps",
    "unresolved_proxy_gaps",
    "candidate_event_ids",
    "independent_source_chain_count",
    "future_event_ids_ignored",
    "outside_window_event_ids_ignored",
    "irrelevant_event_ids_ignored",
    "event_backfill_required",
    "coverage_grade",
    "disposition",
    "authority",
    "report_digest"
  ],
  "properties": {
    "schema_version": {"const": "EventCoverageReport/v1"},
    "intent_class": {"enum": ["MARKET_ATTRIBUTION", "PORTFOLIO_LATEST"]},
    "target_symbols": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "proxy_symbols": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "window_start": {"type": "string", "format": "date-time"},
    "anomaly_or_query_at": {"type": "string", "format": "date-time"},
    "source_authority_state": {"const": "CANONICAL_SOURCE_INSTANCE_AUTHORITY_UNAVAILABLE"},
    "required_coverage_roles": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "observed_coverage_roles": {"type": "array", "items": {"type": "string"}, "maxItems": 0, "uniqueItems": true},
    "scanned_source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "scanned_proxy_symbols": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "unresolved_source_gaps": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "unresolved_proxy_gaps": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "candidate_event_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "independent_source_chain_count": {"type": "integer", "minimum": 0},
    "future_event_ids_ignored": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "outside_window_event_ids_ignored": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "irrelevant_event_ids_ignored": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "event_backfill_required": {"type": "boolean"},
    "coverage_grade": {"const": "INCOMPLETE"},
    "disposition": {"const": "EVENT_COVERAGE_INCOMPLETE"},
    "authority": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"const": false}
    },
    "report_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
