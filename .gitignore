# Generated Python bytecode and test caches are never evidence artifacts.
__pycache__/
*.py[cod]
.pytest_cache/

# Autopilot runtime state (local claims/logs/worktrees) — never committed.
.autopilot-state/
.autopilot-worktrees/

# Creative runtime sessions, generated media, and local provider material remain local.
.creative-runtime/
creative_runtime_runtime/
generated_media/
*.token
*.cookie
