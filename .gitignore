# Generated Python bytecode and test caches are never evidence artifacts.
__pycache__/
*.py[cod]
.pytest_cache/

# Creative runtime sessions, generated media, and local provider material remain local.
.creative-runtime/
creative_runtime_runtime/
generated_media/
*.token
*.cookie

# Future local customer-operations intake is intentionally never a GitHub
# artifact.  Only public-safe schemas and deterministic fixtures may live in
# source control.
customer_runtime/
customer_intake/
customer_uploads/
customer_media/
*.customer.json
